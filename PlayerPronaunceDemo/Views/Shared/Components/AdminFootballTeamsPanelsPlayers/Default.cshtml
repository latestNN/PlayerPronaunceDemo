@model List<PlayerPronaunceDemo.Entities.FootbalPlayer>
@*
    For more information on enabling MVC for empty projects, visit http://go.microsoft.com/fwlink/?LinkID=397860
*@

<table class="detail-table">
    <H2>Sound Info</H2>
    <thead>
        <tr>
            <th>Player Name</th>
            <th>Nation</th>
            <th>Photo</th>
            <th>Sound Count</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>

                <td>
                    <img src="@item.NationFlagImageUrl" alt="Martin Tyler" class="caster-image">
                    󠁧󠁢󠁥󠁮󠁧󠁿 @item.Nation
                </td>
                <td>
                    <div class="caster-image-cell">
                        <img src="@item.ImageUrl" alt="Martin Tyler" class="caster-image">
                        <span>@item.Name</span>
                    </div>
                </td>
                <td>󠁧󠁢@item.Sounds.Count()</td>
                <td>
                    <a href="" class="btn btn-edit">Edit</a>
                </td>
                <td>
                    <a href="" class="btn btn-delete">Delete</a>
                </td>
            </tr>
        }
        
        


    </tbody>
</table>