@using Microsoft.AspNetCore.Http
@{
    // O anki URL bilgisini alıyoruz (Hangi Controller ve Hangi Action'dayız?)
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString(); // YENİ EKLENDİ
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlayerPronaunceDemo</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/AdminPanel/AdminPageStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlayerPronaunceDemo.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="container-fluid p-0 d-flex">

        <nav class="sidebar">

            <div class="sidebar-header">
                <a href="/FutballLeaugeHome/Index">
                    <h2>PRONOUNCE</h2>
                </a>
            </div>

            <ul class="nav-menu">

                <li class="dashboard-item">
                    <a asp-controller="Admin" asp-action="Index"
                       class="dashboard-link">
                        DASHBOARD
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="FootballPlayersList"
                       class="nav-link @(currentController == "Admin" && currentAction == "FootballPlayersList" ? "active" : "")">
                        Football Players List
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="FootballTeamsList"
                       class="nav-link @(currentController == "Admin" && currentAction == "FootballTeamsList" ? "active" : "")">
                        Teams
                    </a>
                </li>

                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Settings"
                       class="nav-link @(currentController == "Admin" && currentAction == "Settings" ? "active" : "")">
                        Settings
                    </a>
                </li>

            </ul>

            <div class="sidebar-bottom">
                <a asp-controller="Profile" asp-action="Index" class="profile-link" style="margin:0; border:none; background:transparent;">
                    <div class="profile-mini-avatar">
                        A
                    </div>
                    <div class="profile-text-info">
                        <div class="profile-text-name">Admin User</div>
                        <div class="profile-text-role">System Admin</div>
                    </div>
                </a>
            </div>

        </nav>
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>