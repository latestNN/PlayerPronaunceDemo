
@model List<PlayerPronaunceDemo.Entities.FootballTeam>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lig Genel Bakış</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/FootballTeamListUI/StyleSheet.css">
</head>
<body>

    <div class="league-wrapper">

        <header class="league-header">
            <h1 class="league-title">Premier League</h1>
            <p class="league-subtitle">2024 - 2025 Sezonu Takımları</p>
        </header>

        <main class="teams-grid">

            @foreach(var item in Model)
            {
                <article class="team-card">
                    <div class="card-image-area">
                        <img src="@item.ImageUrl" alt="@item.Name Logo" class="team-logo">
                    </div>
                    <div class="card-content">
                        <div class="team-info">
                            <span class="team-name">@item.Name</span>
                            <span class="team-origin">
                                @item.Origin
                            </span>
                        </div>
                        <div class="card-action">
                            <a href="/FootballTeam/@item.FootballTeamId" class="details-link">Detayları Gör <span>&rarr;</span></a>
                        </div>
                    </div>
                </article>
            }

            

        </main>
    </div>

</body>
</html>