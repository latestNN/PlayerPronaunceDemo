@model List<PlayerPronaunceDemo.Entities.Sound>


@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Oyuncu Profili - Dark Mode</title>
    <link href="~/css/MainUI/StyleSheet.css" rel="stylesheet" />

</head>
<body>
    <div class="main-wrapper">

        <aside class="person-container">
            <img src="@ViewBag.playerImage" alt="Oyuncu Resmi" class="person-header-image">

            <div class="person-details">
                <h1 class="person-name-title">@ViewBag.playerName</h1>
                <p class="person-subtitle">Profesyonel Oyuncu</p>

                <div class="person-info-grid">
                    <div class="info-row">
                        <span class="info-label">Uyruk:</span>
                        <span class="info-value">
                            <img src="@ViewBag.playerNationFlag" alt="TR" style="width: 20px; vertical-align: middle;"> @ViewBag.playerNation
                        </span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Takım:</span>
                        <span class="info-value">@ViewBag.playerTeam</span>
                    </div>
                    <div class="info-row">
                        <span class="info-label">Logo:</span>
                        <div class="info-value">
                            <img src="@ViewBag.playerTeamImage" alt="Logo" class="person-logo-image">
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="buttons-area">
            <h2 class="section-title">Sunucular</h2>

            <div class="button-grid">


                @foreach(var item in Model)
                {
                    @if(item.IsEpic)
                    {
                        <div class="scroll-card">
                            <div class="epic-btn-wrapper">
                                <button class="scroll-img-button"
                                onclick="openVideoModal('https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1')"
                                style="--img: url('@item.CasterNationImageUrl'); --img-hover: url('@item.CasterImageUrl');">
                                </button>
                            </div>
                            <p class="card-label" style="color: rgba(6, 182, 212, 0.9); font-weight: bold;">★ @item.CasterName ★</p>
                        </div>
                    }

                    else
                    {
                        <div class="scroll-card">
                            <button class="scroll-img-button" style="--img: url('@item.CasterNationImageUrl'); --img-hover: url('@item.CasterImageUrl');"></button>
                            <p class="card-label">@item.CasterName</p>
                        </div>
                    }
                    
                }

                




            </div>
            <div class="video-modal-overlay" id="videoModal" onclick="closeVideoModal()">
                <div class="video-modal-content" onclick="event.stopPropagation()">
                    <button class="close-modal-btn" onclick="closeVideoModal()">&times;</button>
                    <iframe class="video-frame" id="modalIframe" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
                </div>
            </div>

            <script>
                const modal = document.getElementById('videoModal');
                const iframe = document.getElementById('modalIframe');

                function openVideoModal(videoUrl) {
                    // Modalı aktif et
                    modal.classList.add('active');
                    // Videoyu yükle
                    iframe.src = videoUrl;
                }

                function closeVideoModal() {
                    // Modalı gizle
                    modal.classList.remove('active');
                    // Videoyu durdurmak için src'yi boşalt
                    setTimeout(() => {
                        iframe.src = '';
                    }, 300); // Animasyon bitince sil
                }

                // ESC tuşuna basınca kapatma
                document.addEventListener('keydown', function(event) {
                    if (event.key === "Escape") {
                        closeVideoModal();
                    }
                });
            </script>
        </main>
    </div>
</body>
</html>